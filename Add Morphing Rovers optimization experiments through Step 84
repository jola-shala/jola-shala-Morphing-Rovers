,{"cell_type":"code","source":"\nimport numpy as np\n\n# Konfigurimi fillestar i robotit\nbase = np.array(udp.example(), dtype=float)\n\n# Kufijte e parametrave\nlower, upper = udp.get_bounds()\nlower = np.array(lower)\nupper = np.array(upper)\n\n# Numri i parametrave te vazhdueshem\nn_cont = len(base) - udp.get_nix()\n\n# Skenaret e trajnimit\ncases = [(0, 0), (0, 1), (1, 0)]\n\n# Funksioni i vleresimit\ndef evaluate(params):\n    robot = m.Rover(params)\n    scores = []\n\n    for map_id, scenario_id in cases:\n        d, t = udp.run_single_scenario(\n            robot, map_id, scenario_id\n        )\n        scores.append((1 + float(d)) * float(t))\n\n    return float(np.mean(scores))\n\n\n# Funksioni i mutacionit\ndef mutate(parent, rng):\n    child = parent.copy()\n\n    ids = rng.choice(\n        n_cont, size=700, replace=False\n    )\n\n    child[ids] += rng.normal(\n        0, 0.5, size=len(ids)\n    )\n\n    child[:n_cont] = np.clip(\n        child[:n_cont],\n        lower[:n_cont],\n        upper[:n_cont]\n    )\n\n    return child\n\n\n# ALGORITMI 1 - RANDOM SEARCH\ndef random_search(seed=2026):\n    rng = np.random.default_rng(seed)\n\n    best = base.copy()\n    best_score = evaluate(best)\n\n    for i in range(11):\n        candidate = mutate(base, rng)\n        score = evaluate(candidate)\n\n        if score < best_score:\n            best = candidate.copy()\n            best_score = score\n\n    return best, best_score\n\n\n# ALGORITMI 2 - GENETIC ALGORITHM\ndef genetic_algorithm(seed=2026):\n    rng = np.random.default_rng(seed + 5000)\n\n    # Popullata fillestare\n    population = [(base.copy(), evaluate(base))]\n\n    for i in range(3):\n        child = mutate(base, rng)\n        population.append((child, evaluate(child)))\n\n    # Kater gjenerata te tjera\n    for generation in range(4):\n        population.sort(key=lambda item: item[1])\n\n        parent1 = population[0][0]\n        parent2 = population[1][0]\n\n        children = []\n\n        for i in range(2):\n            # Crossover\n            mask = rng.random(n_cont) < 0.5\n            child = parent1.copy()\n\n            child[:n_cont] = np.where(\n                mask,\n                parent1[:n_cont],\n                parent2[:n_cont]\n            )\n\n            # Mutation\n            child = mutate(child, rng)\n            score = evaluate(child)\n\n            children.append((child, score))\n\n        # Elitism\n        population = population[:2] + children\n\n    population.sort(key=lambda item: item[1])\n\n    return population[0]\n\n\nprint(\"Random Search dhe Genetic Algorithm jane gati!\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-30T16:43:06.090703Z","iopub.execute_input":"2026-10-30T16:43:06.091138Z","iopub.status.idle":"2026-10-30T16:43:06.111662Z","shell.execute_reply.started":"2026-10-30T16:43:06.091109Z","shell.execute_reply":"2026-10-30T16:43:06.110739Z"}},"outputs":[{"name":"stdout","text":"Random Search dhe Genetic Algorithm jane gati!\n","output_type":"stream"}],"execution_count":13},{"cell_type":"code","source":"\nimport pandas as pd\nfrom pathlib import Path\n\n# Folderi i projektit\nproject = Path(\n    \"/kaggle/working/SpOC2/Morphing Rovers\"\n)\n\n# Lexojme rezultatet e ruajtura\ndf = pd.read_csv(\n    project / \"final_comparison.csv\"\n)\n\n# Rendisim nga rezultati me i mire\ndf = df.sort_values(\"Fitness\")\n\nprint(\"KRAHASIMI I ALGORITMEVE\")\nprint(df.round(4).to_string(index=False))\n\nprint(\"\\nRezultatet u lexuan me sukses!\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-30T16:43:06.112778Z","iopub.execute_input":"2026-10-30T16:43:06.113278Z","iopub.status.idle":"2026-10-30T16:43:06.148063Z","shell.execute_reply.started":"2026-10-30T16:43:06.113206Z","shell.execute_reply":"2026-10-30T16:43:06.147087Z"}},"outputs":[{"name":"stdout","text":"KRAHASIMI I ALGORITMEVE\n                    Algoritmi  Fitness  Permiresimi_%\n    Random Search Independent  